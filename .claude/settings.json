{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/prompt-sync-guard.py\" post-edit 2>/dev/null || true",
						"timeout": 15
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/prompt-sync-guard.py\" stop 2>/dev/null || true",
						"timeout": 20,
						"statusMessage": "Conferindo se o prompt gerenciado foi publicado…"
					}
				]
			}
		]
	}
}
