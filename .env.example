# ============================================
# Aja Agora — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
#
# Convenção TwoBrains local-dev por workspace:
#   - WORKSPACE_NAME = nome do diretório do worktree atual
#     (gerado automaticamente pela skill .claude/skills/local-dev)
#   - Letta vem de ~/.tb-local/_shared/ (compartilhado entre projetos)
#   - Postgres é isolado por workspace (container aja-pg-<workspace>)
#
# Ver: ~/.tb-local/CONVENTIONS.md

# ---- Workspace ----
# Cada branch/worktree é um workspace isolado. Portas distintas no host
# pra permitir múltiplas branches rodando em paralelo sem colisão.
# Convenção: incremente DB_HOST_PORT a partir de 5433 e APP_HOST_PORT
# a partir de 3000 por workspace.
WORKSPACE_NAME=develop
DB_HOST_PORT=5434
APP_HOST_PORT=3010

# ---- Database ----
# App rodando no host (npm run dev) → use localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aja_agora
# App rodando em container (docker compose --profile containerized) → o
# compose já injeta DATABASE_URL apontando pra aja-pg-<workspace>:5432

# ---- Redis (FIX-44: worker de polling do desfecho, BullMQ) ----
# Host → DNS .orb.local do redis do workspace; container → o compose injeta.
REDIS_URL=redis://redis.aja-<workspace>.orb.local:6379
# Dias sem avanço que marcam a proposta como perdida (timeout nosso).
PERDIDO_INACTIVITY_DAYS=14

# ---- Admin seed (src/scripts/seed-admin.ts) ----
# Exigido pelo docker-compose.yml (ADMIN_EMAIL/ADMIN_PASSWORD required).
# Senha só de dev local — mínimo 8 caracteres.
ADMIN_EMAIL=admin@ajaagora.com.br
ADMIN_PASSWORD=admin123

# ---- Better Auth (exigido pelo docker-compose.yml) ----
# Gere um valor único por workspace: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# ---- Anthropic API ----
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Memória cross-channel (Postgres — FIX-81 / ADR 2026-06-25) ----
# Backend de memória: `postgres` (default, vive na tabela memory_identities do
# DATABASE_URL acima) ou `noop` (desliga a memória). O Letta foi removido.
MEMORY_ADAPTER=postgres
# Separa ambientes (prod/dev/local-<workspace>). Faz parte da chave de identidade.
MEMORY_NAMESPACE=aja-agora-local-develop

# ---- Bevi (fonte ÚNICA de dados — mock em runtime é PROIBIDO) ----
# Descoberta (passos 1-4): Trilho B self-contract. Hash público da loja —
# sem ele a descoberta FALHA ALTO (não existe fallback fictício).
BEVI_SELFCONTRACT_HASH=
# BEVI_SELFCONTRACT_BASE_URL=        # default: core-production-selfcontract (DO)

# Fechamento (passo 5): API de Parceiro. Exige token da loja parceira.
PROPOSAL_GATEWAY=bevi
BEVI_API_TOKEN=
# BEVI_BASE_URL=
# BEVI_PRODUCT_ID=

# ---- Identidade do usuário (gate identify, D1) ----
# Chave de cifra do CPF (AES-256-GCM). Gere com: openssl rand -base64 32
# NUNCA commitar valor real; sem ela o gate identify falha alto.
IDENTITY_ENC_KEY=

# ---- Documentos do cliente (FIX-82 — S3 nosso = fonte da verdade) ----
# Bucket DEDICADO de PII de identidade (RG/CNH/comprovante) — nunca o mesmo do
# S3_BUCKET acima (esse é só de manual de administradora). Em dev usa o MinIO
# local (mesmo S3_ENDPOINT/S3_REGION/credenciais acima, bucket diferente).
S3_CLIENT_DOCS_BUCKET=aja-client-docs
# SSE-KMS: ARN/id da chave dedicada em prod. Bucket+KMS de prod são
# PENDENTE-KAIRO (provisionamento IaC) — em dev/MinIO deixe vazio (MinIO local
# não tem KMS configurado; setar aqui sem KMS de verdade quebra o upload).
S3_CLIENT_DOCS_KMS_KEY_ID=
# Host pelo qual o BROWSER/WhatsApp alcança o storage — a URL de download é
# ASSINADA com ele (SigV4 cobre o Host; trocar depois invalida a assinatura).
# Em dev o app fala com o MinIO por `aja-shared-minio:9000` (rede do Docker),
# host que o browser não resolve. Em prod (S3 real) deixe VAZIO.
S3_PUBLIC_ENDPOINT=


# ---- WhatsApp (Meta Cloud API oficial, Graph v21.0) ----
# Envio via src/lib/whatsapp/api.ts. Sem BSP — bate direto na Graph.
# Token de acesso permanente do app da Meta (System User token).
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone do WhatsApp Business (envio de mensagens é aqui).
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID — CRIAR/LISTAR templates é no WABA, não no phone
# number id (POST/GET /{WABA_ID}/message_templates). PENDENTE-KAIRO: obter o
# valor real na Meta Business; sem ele as operações de template falham alto.
WHATSAPP_WABA_ID=
# Token de verificação do webhook (echo do hub.challenge no handshake da Meta).
WHATSAPP_VERIFY_TOKEN=
# App Secret da Meta — valida a assinatura X-Hub-Signature-256 dos webhooks.
WHATSAPP_APP_SECRET=
# ID do APP da Meta (o mesmo app de onde saem o token e o app secret). Usado só
# pela troca de foto do perfil corporativo (/admin/whatsapp/configuracao): a
# Resumable Upload API abre a sessão em /{APP_ID}/uploads — NÃO no phone number
# id, ao contrário do que quase todo tutorial mostra. Sem ele o resto da tela
# funciona e só o botão da foto fica desabilitado, com o motivo escrito nela.
WHATSAPP_APP_ID=

# ---- Langfuse (observabilidade LLM — self-hosted TwoBrains) ----
# Projeto próprio deste app no Langfuse compartilhado. Sem as 3 envs (ou com
# elas vazias) TODA a observabilidade vira no-op silencioso — o app nunca
# depende do Langfuse pra funcionar. Chaves reais só no .env.local, NUNCA aqui.
LANGFUSE_BASE_URL=https://langfuse.twobrainstechnology.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Alerta do Langfuse por e-mail + ocorrência no Cortex ----
# Os Monitors do Langfuse mandam alerta para Slack, webhook ou GitHub Actions —
# NÃO existe saída de e-mail. A ponte é a rota /api/observability/alerta-langfuse,
# que reconstrói os turnos da janela e manda o e-mail com o trace cruzado.
#
# Segredo gerado pelo Langfuse ao criar a Automation (formato lf-whsec_…). SEM
# ele a rota responde 503 e nada é processado: endpoint sem assinatura seria um
# botão público para disparar e-mail e abrir ocorrência em nosso nome.
LANGFUSE_WEBHOOK_SECRET=
# Destinatários do alerta, separados por vírgula. SEM default no código (regra de
# isolamento da casa): vazio = alerta não sai por e-mail e a rota loga o motivo.
ALERTA_OBSERVABILIDADE_TO=
# Cortex (MCP sobre HTTP) — abre a ocorrência do alerta. Vazio = no-op: o
# e-mail sai do mesmo jeito, o Cortex nunca bloqueia o alerta.
CORTEX_MCP_URL=https://tb-cortex.twobrainstechnology.com/api/mcp
CORTEX_MCP_TOKEN=
CORTEX_PROJETO=Ajaagora

# ---- SendGrid (transactional email) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- App URL ----
APP_URL=http://localhost:3000

# ⚠️ MEDIR FALA DO AGENTE NO LOCAL: com LANGFUSE_BASE_URL preenchido, o container
# serve o prompt PUBLICADO (label `production`), não o do código — editar
# `system-prompt.ts` e medir o comportamento mede o texto errado. Para medir o do
# código, esvazie LANGFUSE_BASE_URL/PUBLIC_KEY/SECRET_KEY e recrie o container;
# confira que o log NÃO traz "difere da constante". Ver
# docs/entregas/2026-08-27-PENDENTE-KAIRO-publicar-prompt.md.

# ---- VITRINE: a carta aparece antes do CPF ----
# Par CPF+celular DA CASA usado só para montar a prateleira de ofertas. Buscar
# carta na Bevi exige criar uma proposta (`ensureOffers`), e proposta exige um
# par válido — era essa exigência que empurrava o gate `identify` para antes da
# busca e matava metade das conversas antes do primeiro número aparecer.
#
# Com estas duas variáveis, a busca roda sob a identidade da casa e o CPF do
# cliente só é pedido no fecho, para reservar a cota no nome dele.
#
# REGRAS:
#  - tem que ser uma conta REAL e registrada na administradora (a Bevi valida o
#    par CPF x celular). Use a Conta 1 de `docs/integracoes/contas-teste-homologacao.md`
#    (vault: `secrets.sh get-key contas-teste CONTA1_CPF`), nunca um CPF inventado:
#    CPF válido ao acaso é o CPF de uma pessoa real, e `consultarDados: true`
#    puxaria dados dela na Receita sem consentimento.
#  - CPF inválido (ou ausente) DESLIGA a vitrine e o funil antigo volta inteiro,
#    exigindo o CPF do cliente antes da busca. É o kill switch.
#  - o celular aceita 11 dígitos (DDD+número) ou 13 (55+DDD+número, como no vault).
#  - PII: só no .env.local e no vault cifrado, nunca aqui e nunca no git.
VITRINE_CPF=
VITRINE_CELULAR=

# ---- Conta de teste da Bevi (gate de eval) ----
# `pnpm eval` exercita a jornada COMPLETA (busca → reveal → contratação) e a
# Bevi valida CPF × celular de verdade — os dois têm que ser um par real da
# conta de teste. Sem eles, 9 dos 19 cenários do golden-set são PULADOS e o
# gate deixa de cobrir exatamente onde o dinheiro está (era o caso até
# 2026-08-13). PII: só no .env.local e no vault cifrado, nunca aqui.
E2E_TEST_CPF=
E2E_TEST_CELULAR=

# Celular REAL de teste pro simulador WhatsApp. A Bevi valida o celular contra o CPF,
# entao o simulador (waId sintetico SIM-uuid) precisa de um numero real pareado com o CPF
# da conta de teste. PII real fica no .env.local/vault, nunca commitado. Ex.: 5562999999999
SIMULATOR_TEST_CELULAR=
